---
/**
 * CurbsideSign — the "what goes in the bin" board, in the layout every
 * municipal solid-waste department prints: a title row flanked by the
 * recycling mark, a green ACCEPTABLE half and a red NOT ACCEPTABLE half,
 * a side rail for the things that need a special trip, a vertical
 * more-info bar, and the brand in the footer.
 *
 * Content comes from `src/data/signs.ts`; every cell links into the Lookup
 * with the item's real name (see `data-search` and the listener in
 * Lookup.svelte). Icons are the AP house style: monochrome line art in the
 * section's ink, not full-colour illustrations.
 *
 * The palette is fixed on purpose — a sign is a printed object, so it keeps
 * its paper and ink in dark mode the way a photograph would. The values are
 * the LBG theme's own (lbg-theme.css); nothing here is a new colour.
 */
import rough from 'roughjs';
import { resolveSign, linkFor, type SignSpec, type SignIcon } from '../data/signs';

interface Props {
  spec: SignSpec;
  /** Unique per sign on a page; the title's id derives from it. */
  id?: string;
  /** Printed in the margin where a print shop puts its job number. */
  code?: string;
  /** When set, the title links to the board's own page. */
  permalink?: string;
}

const { spec, code, id = 'sign', permalink } = Astro.props;
const sign = resolveSign(spec);
const titleId = `${id}-title`;

// 24×24 line-art glyphs. Paths only; the wrapper <svg> supplies stroke/fill.
const ICONS: Record<SignIcon, string> = {
  'newspaper': '<path d="M4 5h13v14H4z"/><path d="M17 8h3v9a2 2 0 0 1-2 2"/><path d="M7 9h4v4H7z"/><path d="M13 9.5h2M13 12.5h2M7 16h8"/>',
  'paper-bag': '<path d="M6 8h12l1 13H5z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/>',
  'sheets': '<path d="M8 3h9l3 3v13H8z"/><path d="M8 7H5v14h11v-3"/><path d="M11 10h6M11 13h6"/>',
  'box': '<path d="M3 8l9-4 9 4-9 4z"/><path d="M3 8v9l9 4 9-4V8"/><path d="M12 12v9"/><path d="M7.5 6l9 4"/>',
  'carton': '<path d="M7 9l2-4h6l2 4v12H7z"/><path d="M7 9h10"/><path d="M12 5v4"/>',
  'can': '<ellipse cx="12" cy="5" rx="5" ry="1.6"/><path d="M7 5v14c0 .9 2.2 1.6 5 1.6s5-.7 5-1.6V5"/><path d="M8.5 10.5h7"/>',
  'tin': '<ellipse cx="12" cy="6" rx="6" ry="2"/><path d="M6 6v12c0 1.1 2.7 2 6 2s6-.9 6-2V6"/><path d="M6 10c0 1.1 2.7 2 6 2s6-.9 6-2"/>',
  'aerosol': '<path d="M8 9h8v11a1 1 0 0 1-1 1H9a1 1 0 0 1-1-1z"/><path d="M10 9V6h4v3"/><path d="M11 6V3.5h2V6"/><path d="M14 4.5h3"/>',
  'bottle': '<path d="M10 3h4v3l2 3v11a1 1 0 0 1-1 1H9a1 1 0 0 1-1-1V9l2-3z"/><path d="M8 13h8"/>',
  'jug': '<path d="M9 3h5v3l3 3v11a1 1 0 0 1-1 1H8a1 1 0 0 1-1-1V9l2-3z"/><path d="M12 10h3v5h-3"/>',
  'plastic-bag': '<path d="M7 8h10l1 13H6z"/><path d="M9 8V5.5a1.5 1.5 0 0 1 3 0V8M12 8V5.5a1.5 1.5 0 0 1 3 0V8"/>',
  'foam-cup': '<path d="M6 5h12l-1.5 15h-9z"/><path d="M5 5h14"/><path d="M7 10h10"/>',
  'chip-bag': '<path d="M7 4h10l-1 3 1 12-1 2H8l-1-2 1-12z"/><path d="M7 7h10M7 19h10"/><path d="M10 11l2 3 2-3"/>',
  'cutlery': '<path d="M7 3v5a2 2 0 0 0 4 0V3M9 3v18"/><path d="M16 3c-2.5 3-2.5 7 0 9v9"/>',
  'pizza-box': '<path d="M3 11h18v9H3z"/><path d="M3 11l2-6h14l2 6"/><circle cx="9" cy="15.5" r="1"/><circle cx="14" cy="16.5" r="1"/>',
  'coffee-cup': '<path d="M5 7h13l-1.4 13H6.4z"/><path d="M18 9h1.5a2 2 0 0 1 0 4h-2"/><path d="M4 7h15"/>',
  'receipt': '<path d="M6 3h12v18l-2-1.5-2 1.5-2-1.5-2 1.5-2-1.5L6 21z"/><path d="M9 8h6M9 11h6M9 14h4"/>',
  'broken-glass': '<path d="M7 3h10l-1.5 18h-7z"/><path d="M12 3l-1 5 2 3-1.5 4"/>',
  'dish': '<path d="M3 11h18a9 9 0 0 1-18 0z"/><path d="M8 20h8"/><path d="M12 17v3"/>',
  'battery': '<rect x="3" y="8" width="16" height="9" rx="1.5"/><path d="M19 11h2v3h-2"/><path d="M7 11v3M10.5 11v3"/>',
  'laptop': '<rect x="4" y="5" width="16" height="11" rx="1"/><path d="M2 19h20"/>',
  'bulb': '<path d="M9 17a6 6 0 1 1 6 0v2H9z"/><path d="M10 21h4"/>',
  'paint-can': '<rect x="6" y="7" width="12" height="14" rx="1"/><path d="M6 11h12"/><path d="M8 7V5a4 4 0 0 1 8 0v2"/>',
  'spray-bottle': '<path d="M9 9h6v12H9z"/><path d="M10 9V6h4v3"/><path d="M12 6V3h4"/><path d="M16 3l2.5 1.5"/>',
  'phone': '<rect x="7" y="2" width="10" height="20" rx="2"/><path d="M10.5 18.5h3"/>',
  'tablet': '<rect x="4" y="3" width="16" height="18" rx="2"/><path d="M11 17.5h2"/>',
  'watch': '<rect x="7" y="7" width="10" height="10" rx="2.5"/><path d="M9 7l.5-4h5l.5 4M9 17l.5 4h5l.5-4"/><path d="M12 10v2.5l1.5 1"/>',
  'monitor': '<rect x="3" y="4" width="18" height="12" rx="1"/><path d="M12 16v4M8 20h8"/>',
  'tv': '<rect x="3" y="7" width="18" height="12" rx="1"/><path d="M7 3l5 4 5-4"/><path d="M8 22h8"/>',
  'printer': '<path d="M7 8V3h10v5"/><rect x="3" y="8" width="18" height="8" rx="1"/><path d="M7 14h10v7H7z"/>',
  'router': '<rect x="3" y="13" width="18" height="7" rx="1"/><path d="M7 16.5h.01M10 16.5h.01"/><path d="M12 13V6"/><path d="M8.5 4.5a5 5 0 0 1 7 0"/>',
  'speaker': '<rect x="6" y="2" width="12" height="20" rx="2"/><circle cx="12" cy="15" r="3.5"/><circle cx="12" cy="7" r="1.5"/>',
  'headphones': '<path d="M4 14v-2a8 8 0 0 1 16 0v2"/><rect x="3" y="14" width="4" height="6" rx="1"/><rect x="17" y="14" width="4" height="6" rx="1"/>',
  'gamepad': '<path d="M6 8h12a4 4 0 0 1 4 4v1a4 4 0 0 1-4 4h-1l-2-2H9l-2 2H6a4 4 0 0 1-4-4v-1a4 4 0 0 1 4-4z"/><path d="M8 11v4M6 13h4"/><path d="M16 12h.01M18 14h.01"/>',
  'camera': '<path d="M4 8h4l2-3h4l2 3h4v11H4z"/><circle cx="12" cy="13.5" r="3.5"/>',
  'microwave': '<rect x="3" y="6" width="18" height="13" rx="1"/><rect x="6" y="9" width="8" height="7"/><path d="M17 10v1M17 13v1"/>',
  'fridge': '<rect x="6" y="2" width="12" height="20" rx="1"/><path d="M6 10h12"/><path d="M9 6v2M9 13v3"/>',
  'drill': '<path d="M3 8h11l3-2v8l-3-2H3z"/><path d="M8 12v6h4l1-6"/><path d="M17 10h4"/>',
  'plug': '<path d="M9 3v5M15 3v5"/><path d="M6 8h12v3a6 6 0 0 1-12 0z"/><path d="M12 17v4"/>',
  'bundle': '<path d="M4 8c4-4 12 4 16 0"/><path d="M4 12c4-4 12 4 16 0"/><path d="M4 16c4-4 12 4 16 0"/><path d="M11 5v14M13 5v14"/>',
  'tire': '<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="4"/><path d="M12 3v5M12 16v5M3 12h5M16 12h5"/>',
  'sofa': '<path d="M4 11V8a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v3"/><path d="M3 11h18v6H3z"/><path d="M5 17v2M19 17v2"/><path d="M3 14h18"/>',
  'shirt': '<path d="M8 3l4 2 4-2 5 4-3 3-2-1v11H8V9L6 10 3 7z"/>',
  'apple': '<path d="M12 7c-3 0-6 2-6 6 0 4 3 8 6 8s6-4 6-8c0-4-3-6-6-6z"/><path d="M12 7V4"/><path d="M12 4c1 0 2.5-1 3.5-1"/>',
  'lock': '<rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/>',
};

// Presentation attributes live on the element: injected markup does not get
// Astro's scoping attribute, so the scoped <style> cannot reach it.
const STROKE = 'fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"';

// ── The sketch renderer ("direction D", approved 2026-09-17) ───────────────
// Every glyph above is re-drawn at build time by Rough.js as a pencil sketch:
// an ink outline that wobbles, and the half's colour hatched inside closed
// shapes (`currentColor`, so CSS `--s-cell` decides lettuce / beet /
// grapefruit). A seed derived from the icon's name keeps each drawing
// identical from build to build. Static SVG ships; nothing runs in the browser.
const INK = '#2b2822';
const gen = rough.generator();
const seedOf = (s: string) => {
  let h = 2166136261;
  for (const c of s) { h ^= c.charCodeAt(0); h = Math.imul(h, 16777619) >>> 0; }
  return (h % 100000) + 1;
};
const attrsOf = (s: string) => Object.fromEntries([...s.matchAll(/([a-z]+)="([^"]*)"/g)].map((m) => [m[1], m[2]]));
const round = (d: string) => d.replace(/-?\d+\.\d+/g, (n) => (+n).toFixed(1));
const icon = (name: SignIcon, hatch = true): string => {
  const out: string[] = [];
  [...ICONS[name].matchAll(/<(path|rect|circle|ellipse)\b([^>]*)\/>/g)].forEach((m, i) => {
    const tag = m[1];
    const a = attrsOf(m[2]);
    const closed = tag !== 'path' || /z\s*$/i.test(a.d);
    const o = {
      roughness: 0.7, bowing: 1.1, seed: seedOf(name) + i, stroke: INK, strokeWidth: 1.15,
      ...(hatch && closed ? { fill: 'currentColor', fillStyle: 'hachure', hachureGap: 3, fillWeight: 0.5, hachureAngle: -41 } : {}),
    };
    const d =
      tag === 'path' ? gen.path(a.d, o)
      : tag === 'rect' ? gen.rectangle(+a.x, +a.y, +a.width, +a.height, o)
      : tag === 'circle' ? gen.circle(+a.cx, +a.cy, 2 * +a.r, o)
      : gen.ellipse(+a.cx, +a.cy, 2 * +a.rx, 2 * +a.ry, o);
    for (const p of gen.toPaths(d)) {
      out.push(`<path d="${round(p.d)}" stroke="${p.stroke}" stroke-width="${p.strokeWidth}" fill="${p.fill || 'none'}"/>`);
    }
  });
  return `<svg class="sign__glyph" viewBox="-1 -1 26 26" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">${out.join('')}</svg>`;
};

// The universal recycling mark. Outline from Lucide (`recycle`, ISC licence),
// so it reads as the real thing at 2rem instead of a hand-drawn approximation.
// Its three arrows are the three logo colours: lettuce, beet, grapefruit.
const RECYCLE_PATHS =
  '<g class="mark-lettuce"><path d="M7 19H4.815a1.83 1.83 0 0 1-1.57-.881 1.785 1.785 0 0 1-.004-1.784L7.196 9.5"/>' +
  '<path d="M8.293 13.596 7.196 9.5 3.1 10.598"/></g>' +
  '<g class="mark-beet"><path d="M11 19h8.203a1.83 1.83 0 0 0 1.556-.89 1.784 1.784 0 0 0 0-1.775l-1.226-2.12"/>' +
  '<path d="m14 16-3 3 3 3"/></g>' +
  '<g class="mark-grapefruit"><path d="m9.344 5.811 1.093-1.892A1.83 1.83 0 0 1 11.985 3a1.784 1.784 0 0 1 1.546.888l3.943 6.843"/>' +
  '<path d="m13.378 9.633 4.096 1.098 1.097-4.096"/></g>';
const recycleMark = `<svg class="sign__mark" viewBox="0 0 24 24" ${STROKE} stroke-width="2" aria-hidden="true" focusable="false">${RECYCLE_PATHS}</svg>`;

---

<section class="sign" id={id} aria-labelledby={titleId}>
  <div class="sign__spine" aria-hidden="true">
    {code && <span class="sign__code">{code}</span>}
  </div>

  <header class="sign__title">
    <Fragment set:html={recycleMark} />
    <h2 id={titleId}>{permalink ? <a href={permalink}>{sign.title}</a> : sign.title}</h2>
    <Fragment set:html={recycleMark} />
  </header>

  <div class="sign__board">
    <div class="sign__half sign__half--yes">
      <div class="sign__band">
        <span class="sign__badge" aria-hidden="true">
          <svg viewBox="0 0 24 24" focusable="false"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>
        </span>
        <div>
          <h3>{sign.yes.heading}</h3>
          <p>{sign.yes.sub}</p>
        </div>
      </div>
      <ul class="sign__groups sign__paper">
        {sign.yes.groups.map((g) => (
          <li>
            <a {...linkFor(g)}>
              <span class="sign__cluster"><Fragment set:html={g.icons.map((i) => icon(i)).join('')} /></span>
              <strong>{g.label}</strong>
              <small>{g.sub}</small>
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div class="sign__half sign__half--no">
      <div class="sign__band">
        <span class="sign__badge" aria-hidden="true">
          <svg viewBox="0 0 24 24" focusable="false"><path d="M7 7l10 10M17 7L7 17"/></svg>
        </span>
        <div>
          <h3>{sign.no.heading}</h3>
          <p>{sign.no.sub}</p>
        </div>
      </div>
      <div class="sign__right">
        <ul class="sign__entries sign__paper">
          {sign.no.entries.map((e) => (
            <li>
              <a {...linkFor(e)}>
                <Fragment set:html={icon(e.icon)} />
                <strong>{e.label}</strong>
              </a>
            </li>
          ))}
        </ul>
        <aside class="sign__rail sign__paper" aria-label={sign.rail.heading}>
          <p class="sign__rail-heading" aria-hidden="true">{sign.rail.heading}</p>
          <ul class="sign__entries sign__entries--rail">
            {sign.rail.entries.map((e) => (
              <li>
                <a {...linkFor(e)}>
                  <Fragment set:html={icon(e.icon)} />
                  <strong>{e.label}</strong>
                  {e.sub && <small>{e.sub}</small>}
                </a>
              </li>
            ))}
          </ul>
        </aside>
      </div>
    </div>
  </div>

  <footer class="sign__foot">
    <a class="sign__brand" href="#home" data-page="home">
      <img src="/images/lbg/lbg-trio-mark-600.webp" alt="" width="600" height="600" loading="lazy" decoding="async" />
      <span>
        <strong>Recyclopedia</strong>
        <small>by Absolutely Plausible Solutions</small>
      </span>
    </a>
    {code && <span class="sign__code sign__code--foot" aria-hidden="true">{code}</span>}
  </footer>

  <a class="sign__bar" href={sign.moreInfo.href} data-page={sign.moreInfo.href === '#recyclopedia' ? 'recyclopedia' : undefined}>{sign.moreInfo.label}</a>
</section>

<script>
  // A click on any cell tells the Lookup island what to search for. main.js
  // handles the page switch (data-page); this only carries the query across.
  // Arriving from a board page as /?item=<name>#donate: fill the item box.
  {
    const item = new URLSearchParams(location.search).get('item');
    const input = document.getElementById('item-input') as HTMLInputElement | null;
    if (item && input) { input.value = item; input.dispatchEvent(new Event('input', { bubbles: true })); }
  }
  document.addEventListener('click', (e) => {
    const a = (e.target as Element | null)?.closest?.('a[data-search], a[data-donate]') as HTMLAnchorElement | null;
    if (!a) return;
    if (a.dataset.search !== undefined) {
      // On the homepage main.js has switched pages; off it, the href navigates
      // and the Lookup reads ?q= itself.
      if (document.getElementById('recycle-search')) {
        window.dispatchEvent(new CustomEvent('recyclopedia:search', { detail: a.dataset.search }));
      }
      return;
    }
    // Donation sign: pre-fill the form's item box and open its suggestions
    // (donate.js renders matches on focus). Off the homepage the href navigates.
    const input = document.getElementById('item-input') as HTMLInputElement | null;
    if (!input) return;
    e.preventDefault();
    input.value = a.dataset.donate ?? '';
    input.dispatchEvent(new Event('input', { bubbles: true }));
    input.scrollIntoView({ block: 'center' });
    input.focus({ preventScroll: true });
  });
</script>

<style>
  .sign {
    /* Printed-sign palette: LBG paper, ink, lettuce, beet, and the drop-off
       amber. Fixed in both colour schemes on purpose (see the header note). */
    --s-paper: #fcfaf4;
    --s-ink: #2b2822;
    --s-muted: #77705f;
    /* The three logo colours, one job each: lettuce = yes, beet = no,
       grapefruit = the rail. One light tint of each for the fields. The
       frame is ink, so no fourth shade competes with them. */
    --s-yes: #57862f;
    --s-no: #8a2450;
    --s-rail: #e4562e;
    --s-frame: var(--s-ink);
    --s-white: #fcfaf4;
    /* Graph paper: a 10px grid with a heavier line every fifth, in faint ink. */
    --s-grid: rgba(43, 40, 34, 0.11);
    --s-grid-major: rgba(43, 40, 34, 0.2);

    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas: 'title' 'board' 'foot' 'bar';
    background: var(--s-paper);
    color: var(--s-ink);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    overflow: hidden;
    font-family: var(--font);
    margin-top: var(--space-6, 2.5rem);
  }

  /* ── Margin spine (desktop only): print blocks + job code ─────────────── */
  .sign__spine {
    display: none;
    grid-area: spine;
    position: relative;
    background:
      linear-gradient(var(--s-frame), var(--s-frame)) top / 100% 3.25rem no-repeat,
      linear-gradient(var(--s-frame), var(--s-frame)) bottom / 100% 6.5rem no-repeat,
      var(--s-paper);
  }
  .sign__code {
    font-family: 'Share Tech Mono', ui-monospace, monospace;
    font-size: 0.68rem;
    color: var(--s-muted);
    letter-spacing: 0.04em;
  }
  .sign__spine .sign__code {
    position: absolute;
    top: 4.25rem;
    left: 50%;
    transform: translateX(-50%) rotate(180deg);
    writing-mode: vertical-rl;
    white-space: nowrap;
  }

  /* ── Title row ────────────────────────────────────────────────────────── */
  .sign__title {
    grid-area: title;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-3, 0.75rem);
    padding: var(--space-4, 1.25rem) var(--gutter, 1rem) var(--space-3, 0.9rem);
    text-align: center;
  }
  .sign__title h2 {
    margin: 0;
    font-family: var(--font);
    font-weight: 700;
    font-size: clamp(1.25rem, 1rem + 2.4vw, 2.35rem);
    line-height: 1.05;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    color: var(--s-ink);
  }
  .sign :global(.sign__mark) {
    width: clamp(2rem, 1.2rem + 4vw, 4rem);
    height: auto;
  }
  .sign :global(.mark-lettuce) { color: var(--s-yes); }
  .sign :global(.mark-beet) { color: var(--s-no); }
  .sign :global(.mark-grapefruit) { color: var(--s-rail); }

  /* ── Board: the two halves ────────────────────────────────────────────── */
  .sign__board {
    grid-area: board;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }
  .sign__half { display: grid; grid-template-rows: auto minmax(0, 1fr); }
  .sign__half--yes { --s-band: var(--s-yes); }
  .sign__half--no  { --s-band: var(--s-no); }
  .sign__paper {
    background-color: var(--s-paper);
    background-image:
      linear-gradient(var(--s-grid-major) 1px, transparent 1px),
      linear-gradient(90deg, var(--s-grid-major) 1px, transparent 1px),
      linear-gradient(var(--s-grid) 1px, transparent 1px),
      linear-gradient(90deg, var(--s-grid) 1px, transparent 1px);
    background-size: 50px 50px, 50px 50px, 10px 10px, 10px 10px;
  }
  .sign__title h2 a { color: inherit; text-decoration: none; }
  .sign__title h2 a:hover { text-decoration: underline; text-decoration-thickness: 3px; text-underline-offset: 0.12em; }
  .sign__title h2 a:focus-visible { outline: 3px solid var(--s-ink); outline-offset: 4px; }

  .sign__band {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: var(--space-3, 0.75rem);
    padding: var(--space-3, 0.8rem) var(--gutter, 1rem);
    background: var(--s-band);
    color: var(--s-white);
  }
  .sign__band h3 {
    margin: 0;
    font-family: var(--font);
    font-weight: 700;
    font-size: clamp(1.1rem, 0.9rem + 1.4vw, 1.75rem);
    line-height: 1.05;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: inherit;
  }
  .sign__band p {
    margin: 0.2rem 0 0;
    font-size: 0.86rem;
    line-height: 1.3;
    max-width: 44ch;
    color: inherit;
  }
  .sign__badge {
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 50%;
    background: var(--s-white);
    color: var(--s-band);
    flex: none;
  }
  .sign__badge svg {
    width: 1.6rem;
    height: 1.6rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 3;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* Shared cell styling: every cell is a link into the Lookup. */
  .sign ul { list-style: none; margin: 0; padding: 0; }
  .sign li > a {
    display: grid;
    justify-items: center;
